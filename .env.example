# OpenAI Config
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Config
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini Config
GEMINI_API_KEY=your_gemini_api_key_here

# Configuración de Proveedor por defecto
# Opciones: 'openai', 'anthropic', 'gemini' o dejar vacío para consultar concurrentemente a los tres
DEFAULT_PROVIDER=

# Modelo por defecto general
DEFAULT_MODEL=gemini-2.5-flash

# Parámetros del modelo
TEMPERATURE=0.7
MAX_TOKENS=256

# Modelo de Embeddings para RAG (Módulo 3)
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Pinecone Cloud & Embeddings Config (Módulo 4)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=coderhouse-rag-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=dev-technical-docs
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
