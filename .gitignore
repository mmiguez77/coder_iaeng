# Ignorar entorno virtual local del proyecto
.venv/
venv/

# Ignorar archivos de variables de entorno locales (secretos)
.env

# Ignorar caches de compilación de Python
__pycache__/
*.py[cod]

# Ignorar la carpeta física de logs locales
logs/

# Ignorar bitácora de desarrollo local del agente
agent.md

# Ignorar base de datos vectorial local de ChromaDB (Módulo 3)
vectorstore/

# Ignorar archivos temporales o artefactos accidentales de redirección en shell
=*
